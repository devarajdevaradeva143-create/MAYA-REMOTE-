<Window x:Class="MayaRemote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Maya Remote" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12">
            <TextBlock Text="Maya Remote" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="Gray" />
        </StackPanel>

        <Border Grid.Row="1" Margin="12" BorderBrush="#CCC" BorderThickness="1">
            <TextBlock Text="Remote desktop view" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#666" />
        </Border>
    </Grid>
</Window>
