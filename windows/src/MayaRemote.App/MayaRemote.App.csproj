<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MayaRemote.App</RootNamespace>
    <AssemblyName>MayaRemote.App</AssemblyName>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
    <Compile Include="App.xaml.cs" />
    <Compile Include="MainWindow.xaml.cs" />
    <Compile Include="Views\**\*.cs" />
    <Compile Include="ViewModels\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MayaRemote.Core\MayaRemote.Core.csproj" />
    <ProjectReference Include="..\MayaRemote.Networking\MayaRemote.Networking.csproj" />
    <ProjectReference Include="..\MayaRemote.WindowsServices\MayaRemote.WindowsServices.csproj" />
    <ProjectReference Include="..\MayaRemote.Infrastructure\MayaRemote.Infrastructure.csproj" />
  </ItemGroup>

</Project>
